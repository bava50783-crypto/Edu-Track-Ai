# ==============================================================================
# EduTrack AI – Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE / POSTGRESQL DATABASE (Backend Connectivity)
# ------------------------------------------------------------------------------
# Direct or Pooler URI from Supabase: Project Settings -> Database -> Connection string (URI)
# Use Transaction Pooler (port 6543) for Node.js / Express servers
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Optional: Individual credentials fallback if not using DATABASE_URL
# SUPABASE_DB_HOST="aws-0-[REGION].pooler.supabase.com"
# SUPABASE_DB_PORT=6543
# SUPABASE_DB_USER="postgres.[YOUR-PROJECT-REF]"
# SUPABASE_DB_PASSWORD="[YOUR-PASSWORD]"
# SUPABASE_DB_NAME="postgres"
# DB_SSL="true"

# ------------------------------------------------------------------------------
# 2. SUPABASE API KEYS (Project Settings -> API)
# ------------------------------------------------------------------------------
# Supabase Project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"

# Supabase Anon / Public Key (Safe for client-side)
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase Service Role Key (Secret! Server-side only, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# 3. VITE FRONTEND SUPABASE CONFIGURATION (Exposed to browser)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# 4. GEMINI AI API KEY
# ------------------------------------------------------------------------------
# Required for EduTrack AI features (study plans, PDF summarization, quick ask)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ------------------------------------------------------------------------------
# 5. APPLICATION URL & PORT
# ------------------------------------------------------------------------------
PORT=3000
APP_URL="http://localhost:3000"
